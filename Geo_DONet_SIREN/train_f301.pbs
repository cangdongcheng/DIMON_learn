#!/bin/bash
#PBS -N siren_f301
#PBS -l select=1:ngpus=1
#PBS -l walltime=30:00:00
#PBS -j oe
#
# Plain SIREN on f301 (2 ms sampling) — the f601 npz strided by 2 (--frame-step 2),
# vs the f121 (5 ms) baseline. With 2-3 samples over the AP upstroke (vs 0-1 at
# step 5), SIREN should sharpen the depolarisation. Submit:   qsub train_f301.pbs
#
# SIREN gradient-checkpoints the trunk by default (CONFIGURATION GRAD_CHECKPOINT),
# which is what lets f301 fit the 48 GB A40 at batch 24. expandable_segments cuts
# allocator fragmentation. ~0.46 min/ep at 3000 ep => ~23 h; 30 h leaves margin.

source ~/load_dimon_env.sh
cd /home/svu/e1032484/DIMON_learn/Geo_DONet_SIREN

echo "=== START $(date) ==="
echo "node: $(hostname)"
nvidia-smi

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

#   -> CheckPts/geodonet_siren_w300_d4_w0_30_3000ep_f301.pt
python -u main.py --epochs 3000 --width 300 --batch-size 24 \
    --data-path geo_donet_data_f601.npz --frame-step 2 --omega-0 30 --device cuda

echo "=== DONE $(date) ==="

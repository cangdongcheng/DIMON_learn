#!/bin/bash
#PBS -N siren_f121
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe
#
# Plain SIREN baseline on f121 (5 ms sampling). The f601 npz strided by 5 on load
# (--frame-step 5) gives 121 frames, so no separate f121 file is needed.
# Submit from this folder:   qsub train.pbs
#
# Defaults live in main.py's CONFIGURATION block (omega_0=30, width 300, depth 4,
# batch 24, flat lr 1e-4, grad-checkpoint on). SIREN gradient-checkpoints the trunk
# by default, so f121 fits the 48 GB A40 with room to spare.

source ~/load_dimon_env.sh
cd /home/svu/e1032484/DIMON_learn/Geo_DONet_SIREN

echo "=== START $(date) ==="
echo "node: $(hostname)"
nvidia-smi

#   -> CheckPts/geodonet_siren_w300_d4_w0_30_5000ep_f121.pt
#   -> Predictions/geodonet_siren_w300_d4_w0_30_5000ep_f121/{loss.txt,loss.png}
python -u main.py --epochs 5000 --width 300 --batch-size 24 \
    --data-path geo_donet_data_f601.npz --frame-step 5 --omega-0 30 --device cuda

echo "=== DONE $(date) ==="

#!/bin/bash
#PBS -N Geo_DONet_SIREN
#PBS -l walltime=14:00:00
#PBS -l select=1:ncpus=32:ngpus=1:mem=400gb
#PBS -P personal-e1590340
#PBS -j oe

source ~/load_dimon_env.sh
cd /home/users/nus/e1590340/cardiac_simulation/DIMON/Geo_DONet_SIREN

echo "=== START $(date) ==="
echo "Node: $(hostname)"
nvidia-smi

# --omega-0: SIREN frequency (paper default 30). Drop to 10 if training oscillates.
# --trunk: "cobiveco" (4D ab,rt,tm,tv) or "xyz" (3D Cartesian).
python -u main.py --width 300 --batch-size 24 --epochs 5000 --device cuda --trunk cobiveco --omega-0 30

echo "=== DONE $(date) ==="

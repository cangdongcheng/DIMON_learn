#!/bin/bash
#PBS -N Geo_DONet
#PBS -l walltime=14:00:00
#PBS -l select=1:ncpus=32:ngpus=1:mem=400gb
#PBS -P personal-e1590340
#PBS -j oe

source ~/load_dimon_env.sh
cd /home/users/nus/e1590340/cardiac_simulation/DIMON/Geo_DONet

echo "=== START $(date) ==="
echo "Node: $(hostname)"
nvidia-smi

# --trunk: "cobiveco" (4D ab,rt,tm,tv) or "xyz" (3D Cartesian). Edit here to switch.
python -u main.py --width 300 --batch-size 24 --epochs 10000 --lr-schedule --device cuda --trunk xyz

echo "=== DONE $(date) ==="
